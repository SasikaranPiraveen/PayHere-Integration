# ---- Clerk (dashboard.clerk.com -> API keys) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/catalog
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/catalog

# ---- Supabase (Project settings -> API). SERVICE ROLE KEY IS SERVER-ONLY. ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- PayHere sandbox (sandbox.payhere.lk -> Integrations / domain) ----
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=your_sandbox_merchant_id
PAYHERE_MERCHANT_SECRET=your_sandbox_merchant_secret

# Merchant API app (PayHere -> Settings -> API Keys) for Retrieval + Refund APIs.
# Required for refunds and reconciliation (sandbox and live). Checkout works without them.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=

# Public HTTPS URL of THIS app (needed for notify_url). Use a tunnel locally, e.g. cloudflared/ngrok.
APP_URL=https://your-public-test-domain.example

# Optional. Public base URL that PayHere posts notify callbacks to (e.g. a Cloudflare quick tunnel)
# while you pay from http://localhost:3000. Leave unset in production.
PAYHERE_NOTIFY_BASE_URL=

# Comma-separated Clerk user ids allowed into /admin (or set publicMetadata {"role":"admin"} in Clerk).
ADMIN_USER_IDS=user_xxx

# Bearer token for /api/cron/outbox and /api/cron/reconcile (min 16 chars).
# If unset, both cron endpoints reject every request.
CRON_SECRET=

# Set to "enforce" after verifying no CSP violations in the browser console.
CSP_MODE=report-only
